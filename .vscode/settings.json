{
    "editor.useTabStops": false,
    "editor.tabSize": 4,
    "search.exclude": {
        "**/.git": true,
        "**/.tox": true,
        "**/.dist": true,
        "**/.cache": true,
        "**/xcrun.egg-info": true
    },
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "black-formatter.args": [
        "--line-length",
        "100"
    ]
}